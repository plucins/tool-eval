{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tool-eval.internal/schemas/use-case.schema.json",
  "title": "Use case",
  "description": "A workflow/use case for the tool (requirements Sec 14). Either vendor-documented (source-backed) or LLM-inferred (labelled, with rationale, supporting features, and evidence). Inferred use cases do not affect flags.",
  "type": "object",
  "additionalProperties": false,
  "required": ["use_case_id", "title", "description", "kind"],
  "properties": {
    "use_case_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["documented", "inferred"] },
    "supporting_features": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
    },
    "rationale": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "excerpt"],
        "properties": {
          "source_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "excerpt": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "documented" } } },
      "then": {
        "required": ["evidence"],
        "properties": { "evidence": { "minItems": 1 } }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "inferred" } } },
      "then": {
        "required": ["rationale", "supporting_features"],
        "properties": { "supporting_features": { "minItems": 1 } }
      }
    }
  ]
}
