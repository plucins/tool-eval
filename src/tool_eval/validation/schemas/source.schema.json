{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tool-eval.internal/schemas/source.schema.json",
  "title": "Source registry entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "url", "title", "source_type", "checked_at", "available", "official"],
  "properties": {
    "source_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "url": { "type": "string", "pattern": "^https?://[^\\s]+$" },
    "title": { "type": "string" },
    "source_type": {
      "type": "string",
      "enum": [
        "documentation",
        "product_page",
        "changelog",
        "pricing",
        "integration_catalog",
        "specialist",
        "other"
      ]
    },
    "checked_at": { "type": "string", "format": "date" },
    "available": { "type": "boolean" },
    "official": { "type": "boolean" },
    "redirect_from": { "type": "string", "pattern": "^https?://[^\\s]+$" }
  }
}
