<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <style>{{ assets.bootstrap_css|safe }}</style>
  <style>{{ assets.theme_css|safe }}</style>
</head>
<body>
  <svg aria-hidden="true" style="position:absolute;width:0;height:0;overflow:hidden" focusable="false">
    <symbol id="cg-icon-has" viewBox="0 0 16 16"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M3 8.5 6.5 12 13 4"/></symbol>
    <symbol id="cg-icon-partial" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="2"/><path fill="currentColor" d="M8 2a6 6 0 0 1 0 12z"/></symbol>
    <symbol id="cg-icon-not_found" viewBox="0 0 16 16"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M4 4l8 8M12 4l-8 8"/></symbol>
    <symbol id="cg-icon-uncertain" viewBox="0 0 16 16"><text x="8" y="12" text-anchor="middle" font-size="11" font-weight="700" fill="currentColor">?</text></symbol>
    <!-- Distribution-flag glyphs (one per flag_meta key). currentColor is set by the .cg-flag-<key> colour class. -->
    <symbol id="cg-icon-flag-common" viewBox="0 0 16 16"><circle cx="3.5" cy="8" r="1.9" fill="currentColor"/><circle cx="8" cy="8" r="1.9" fill="currentColor"/><circle cx="12.5" cy="8" r="1.9" fill="currentColor"/></symbol>
    <symbol id="cg-icon-flag-only_lacks" viewBox="0 0 16 16"><circle cx="3.5" cy="8" r="1.9" fill="currentColor"/><circle cx="8" cy="8" r="1.9" fill="currentColor"/><circle cx="12.5" cy="8" r="1.9" fill="none" stroke="currentColor" stroke-width="1.4"/></symbol>
    <symbol id="cg-icon-flag-only_has" viewBox="0 0 16 16"><path fill="currentColor" d="M8 1.5l1.85 3.75 4.15.6-3 2.93.71 4.12L8 11.48 4.29 13.4 5 9.28l-3-2.93 4.15-.6z"/></symbol>
    <symbol id="cg-icon-flag-rare" viewBox="0 0 16 16"><path fill="currentColor" d="M8 2.2l3.4 5.8L8 13.8 4.6 8z"/></symbol>
    <symbol id="cg-icon-flag-split" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="1.6"/><path fill="currentColor" d="M8 2a6 6 0 0 0 0 12z"/></symbol>
    <symbol id="cg-icon-flag-varied" viewBox="0 0 16 16"><path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" d="M2 10.5c1.6 0 1.6-5 3.2-5s1.6 5 3.2 5 1.6-5 3.2-5 1.6 5 3.2 5"/></symbol>
    <symbol id="cg-icon-flag-other" viewBox="0 0 16 16"><path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" d="M4 2v12M4 3h7l-1.5 2.5L11 8H4"/></symbol>
    <!-- Page-level tab glyphs. -->
    <symbol id="cg-icon-tab-comparison" viewBox="0 0 16 16"><rect x="1.5" y="1.5" width="5.5" height="5.5" rx="1" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="9" y="1.5" width="5.5" height="5.5" rx="1" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="1.5" y="9" width="5.5" height="5.5" rx="1" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="9" y="9" width="5.5" height="5.5" rx="1" fill="none" stroke="currentColor" stroke-width="1.4"/></symbol>
    <symbol id="cg-icon-tab-profiles" viewBox="0 0 16 16"><circle cx="8" cy="5.2" r="2.7" fill="none" stroke="currentColor" stroke-width="1.4"/><path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" d="M2.3 14c.7-3 3-4.6 5.7-4.6s5 1.6 5.7 4.6"/></symbol>
    <!-- Feature-group glyphs (one per config/feature-taxonomy.yaml group_id); "other" is the fallback for unmapped ids. -->
    <symbol id="cg-icon-group-code_authoring" viewBox="0 0 16 16"><path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" d="M5.5 4 2 8l3.5 4M10.5 4 14 8l-3.5 4M9 3 7 13"/></symbol>
    <symbol id="cg-icon-group-agentic_execution" viewBox="0 0 16 16"><rect x="4" y="6" width="8" height="6.5" rx="1.4" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="6.4" cy="9.3" r=".9" fill="currentColor"/><circle cx="9.6" cy="9.3" r=".9" fill="currentColor"/><path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" d="M8 6V3.3M2.5 8.5h1.5M12 8.5h1.5"/><circle cx="8" cy="2.4" r="1" fill="none" stroke="currentColor" stroke-width="1.2"/></symbol>
    <symbol id="cg-icon-group-agent_customization_orchestration" viewBox="0 0 16 16"><path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" d="M2 4.5h7M11.5 4.5H14M2 8h4M6.5 8H14M2 11.5h9M13 11.5h1"/><circle cx="10" cy="4.5" r="1.5" fill="currentColor"/><circle cx="5.2" cy="8" r="1.5" fill="currentColor"/><circle cx="11.6" cy="11.5" r="1.5" fill="currentColor"/></symbol>
    <symbol id="cg-icon-group-context_quality" viewBox="0 0 16 16"><circle cx="6.8" cy="6.8" r="4.3" fill="none" stroke="currentColor" stroke-width="1.4"/><path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" d="m10 10 3.6 3.6"/></symbol>
    <symbol id="cg-icon-group-workflow_ecosystem" viewBox="0 0 16 16"><circle cx="3" cy="3.2" r="1.7" fill="none" stroke="currentColor" stroke-width="1.3"/><circle cx="13" cy="3.2" r="1.7" fill="none" stroke="currentColor" stroke-width="1.3"/><circle cx="8" cy="13" r="1.7" fill="none" stroke="currentColor" stroke-width="1.3"/><path fill="none" stroke="currentColor" stroke-width="1.2" d="M4.5 4.2 6.9 11M11.5 4.2 9.1 11M4.7 3.2h6.6"/></symbol>
    <symbol id="cg-icon-group-security_governance" viewBox="0 0 16 16"><path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" d="M8 1.6 13.5 3.5v4.1c0 3.6-2.4 6.1-5.5 6.8-3.1-.7-5.5-3.2-5.5-6.8V3.5z"/><path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" d="M5.7 8.1 7.3 9.7l3-3.4"/></symbol>
    <symbol id="cg-icon-group-other" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="1.4"/><path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" d="M8 5v3.4M8 11h.01"/></symbol>
    <!-- KPI tile glyphs. -->
    <symbol id="cg-icon-kpi-tools" viewBox="0 0 16 16"><rect x="1.5" y="1.5" width="5.5" height="5.5" rx="1" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="9" y="1.5" width="5.5" height="5.5" rx="1" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="1.5" y="9" width="5.5" height="5.5" rx="1" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="9" y="9" width="5.5" height="5.5" rx="1" fill="none" stroke="currentColor" stroke-width="1.4"/></symbol>
    <symbol id="cg-icon-kpi-groups" viewBox="0 0 16 16"><path fill="currentColor" d="M8 1.6 14 5 8 8.4 2 5z"/><path fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" d="m2 8 6 3.4 6-3.4M2 11l6 3.4 6-3.4"/></symbol>
    <symbol id="cg-icon-kpi-features" viewBox="0 0 16 16"><path fill="currentColor" d="M8 1.6l1.85 3.9 4.15.62-3 3 .71 4.28L8 11.5l-3.71 1.9L5 9.12l-3-3 4.15-.62z"/></symbol>
    <symbol id="cg-icon-kpi-flags" viewBox="0 0 16 16"><path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" d="M3.5 1.5v13"/><path fill="currentColor" d="M3.5 2.2h8.3l-2 2.9 2 2.9H3.5z"/></symbol>
    <symbol id="cg-icon-kpi-warnings" viewBox="0 0 16 16"><path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" d="M8 1.6 13.5 3.5v4.1c0 3.6-2.4 6.1-5.5 6.8-3.1-.7-5.5-3.2-5.5-6.8V3.5z"/></symbol>
    <symbol id="cg-icon-chevron-right" viewBox="0 0 16 16"><path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" d="M6 3.5 10.5 8 6 12.5"/></symbol>
    <!-- Approximate brand cloud mark; hand-authored, not a reproduction of any official logo artwork. -->
    <symbol id="cg-icon-brand-mark" viewBox="0 0 32 32">
      <path fill="#fff" d="M9.5 21.5a5.5 5.5 0 0 1-.6-10.97 7 7 0 0 1 13.4-2.1 5.8 5.8 0 0 1 1.2 11.4z" opacity="0.95"/>
      <path fill="none" stroke="#0070ad" stroke-width="1.6" stroke-linecap="round" d="M7 20.5c3-5 6-7.5 11-7.5"/>
    </symbol>
  </svg>

  <svg class="cg-header-wave" viewBox="0 0 640 220" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path fill="none" stroke="#fff" stroke-opacity="0.35" stroke-width="1.5" d="M40 190C160 190 200 60 340 60S520 170 620 40"/>
    <path fill="none" stroke="#fff" stroke-opacity="0.2" stroke-width="1" d="M0 150C120 170 220 40 360 90S560 140 640 20"/>
    <circle cx="596" cy="52" r="2.5" fill="#fff"/>
    <circle cx="470" cy="150" r="1.8" fill="#fff" opacity="0.7"/>
    <circle cx="230" cy="72" r="1.6" fill="#fff" opacity="0.6"/>
    <circle cx="80" cy="176" r="1.6" fill="#fff" opacity="0.5"/>
  </svg>

  <header class="cg-header">
    <div class="container position-relative">
      <div class="cg-brand">
        <svg class="cg-brand-mark" aria-hidden="true"><use href="#cg-icon-brand-mark"/></svg>
        <span class="cg-brand-name">Capgemini</span>
      </div>
      <h1>{{ title }}</h1>
      <div class="cg-subtitle">Generated {{ model.generated_at }} &middot; {{ model.tools|length }} tools compared</div>
    </div>
  </header>

  <main class="container">
    <div class="cg-panel">
      <ul class="nav cg-page-tabs" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link active" id="page-tab-comparison" data-bs-toggle="tab"
                  data-bs-target="#page-comparison" type="button" role="tab">
            <svg class="cg-page-tab-icon" aria-hidden="true"><use href="#cg-icon-tab-comparison"/></svg>Comparison
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="page-tab-profiles" data-bs-toggle="tab"
                  data-bs-target="#page-profiles" type="button" role="tab">
            <svg class="cg-page-tab-icon" aria-hidden="true"><use href="#cg-icon-tab-profiles"/></svg>Profiles
          </button>
        </li>
      </ul>

      <div class="tab-content">
        <div class="tab-pane fade show active p-3 p-md-4" id="page-comparison" role="tabpanel">

    <section aria-label="Summary" class="cg-kpi-row row row-cols-2 row-cols-md-5 g-3 mb-4">
      <div class="col">
        <div class="cg-kpi-card">
          <div class="d-flex align-items-center gap-3">
            <span class="cg-kpi-icon cg-kpi-icon-tools" aria-hidden="true"><svg><use href="#cg-icon-kpi-tools"/></svg></span>
            <div>
              <div class="cg-kpi-number">{{ summary.tool_count }}</div>
              <div class="cg-kpi-label">Tools compared</div>
            </div>
          </div>
          <div class="mt-2">
            {% for key in ["current", "aging", "stale"] %}
            {% if summary.freshness_counts[key] %}
            <span class="cg-fresh cg-fresh-{{ key }}">{{ summary.freshness_counts[key] }} {{ freshness_labels[key] }}</span>
            {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
      <div class="col">
        <div class="cg-kpi-card">
          <div class="d-flex align-items-center gap-3">
            <span class="cg-kpi-icon cg-kpi-icon-groups" aria-hidden="true"><svg><use href="#cg-icon-kpi-groups"/></svg></span>
            <div>
              <div class="cg-kpi-number">{{ summary.group_count }}</div>
              <div class="cg-kpi-label">Feature groups</div>
            </div>
          </div>
        </div>
      </div>
      <div class="col">
        <div class="cg-kpi-card">
          <div class="d-flex align-items-center gap-3">
            <span class="cg-kpi-icon cg-kpi-icon-features" aria-hidden="true"><svg><use href="#cg-icon-kpi-features"/></svg></span>
            <div>
              <div class="cg-kpi-number">{{ summary.feature_count }}</div>
              <div class="cg-kpi-label">Features evaluated</div>
            </div>
          </div>
          <div class="mt-2">
            {% for key in ["has", "partial", "not_found", "uncertain"] %}
            {% if summary.status_counts[key] %}
            <span class="cg-status cg-status-{{ key }}"><svg class="cg-status-icon" aria-hidden="true"><use href="#cg-icon-{{ key }}"/></svg>{{ summary.status_counts[key] }}</span>
            {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
      <div class="col">
        <div class="cg-kpi-card">
          <div class="d-flex align-items-center gap-3">
            <span class="cg-kpi-icon cg-kpi-icon-flags" aria-hidden="true"><svg><use href="#cg-icon-kpi-flags"/></svg></span>
            <div>
              <div class="cg-kpi-number">{{ summary.flagged_feature_count }}</div>
              <div class="cg-kpi-label">Flagged features</div>
            </div>
          </div>
        </div>
      </div>
      <div class="col">
        <div class="cg-kpi-card">
          <div class="d-flex align-items-center gap-3">
            <span class="cg-kpi-icon cg-kpi-icon-warnings" aria-hidden="true"><svg><use href="#cg-icon-kpi-warnings"/></svg></span>
            <div>
              <div class="cg-kpi-number">{{ summary.warning_count }}</div>
              <div class="cg-kpi-label">Warnings</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {% if model.warnings %}
    <section aria-label="Warnings" class="mb-3">
      {% for warning in model.warnings %}
      <div class="cg-warning">&#9888; {{ warning }}</div>
      {% endfor %}
    </section>
    {% endif %}

    <div class="cg-subtabs-bar d-flex align-items-center gap-2 mb-3">
      <ul class="nav cg-subtabs flex-nowrap" id="cg-group-tabs-track" role="tablist">
        {% for group in model.groups %}
        <li class="nav-item" role="presentation">
          <button class="nav-link{% if loop.first %} active{% endif %}"
                  id="tab-{{ group.group_id }}" data-bs-toggle="tab"
                  data-bs-target="#panel-{{ group.group_id }}" type="button" role="tab">
            <svg class="cg-subtab-icon" aria-hidden="true"><use href="#cg-icon-group-{{ group_icons.get(group.group_id, 'other') }}"/></svg>{{ group.name }}
          </button>
        </li>
        {% endfor %}
      </ul>
      <button type="button" class="cg-subtabs-scroll" data-cg-scroll-target="cg-group-tabs-track" aria-label="Scroll feature-group tabs">
        <svg class="cg-subtabs-scroll-icon" aria-hidden="true"><use href="#cg-icon-chevron-right"/></svg>
      </button>
    </div>

    <div class="tab-content">
      {% for group in model.groups %}
      <div class="tab-pane fade{% if loop.first %} show active{% endif %}"
           id="panel-{{ group.group_id }}" role="tabpanel">
        <div class="cg-card">
          <div class="cg-card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="d-flex align-items-center gap-2">
              <span class="cg-card-icon" aria-hidden="true"><svg><use href="#cg-icon-group-{{ group_icons.get(group.group_id, 'other') }}"/></svg></span>
              <div>
                <h2 class="h6 mb-0">{{ group.name }}</h2>
                {% if group_descriptions.get(group.group_id) %}
                <div class="cg-card-subtitle text-muted small">{{ group_descriptions[group.group_id] }}</div>
                {% endif %}
              </div>
            </div>
            <div class="d-flex align-items-center gap-2">
              <span class="text-muted small">{{ group.features|length }} feature{{ 's' if group.features|length != 1 else '' }}</span>
              <input type="search" class="form-control form-control-sm" style="max-width:16rem"
                     placeholder="Filter features&hellip;" data-cg-filter="table-{{ group.group_id }}">
            </div>
          </div>
          <div class="cg-card-body p-0">
            <div class="table-responsive">
              <table class="table cg-table align-middle mb-0" id="table-{{ group.group_id }}">
                <thead>
                  <tr>
                    <th scope="col">Feature</th>
                    {% for tool in model.tools %}
                    <th scope="col">{{ tool.name }}</th>
                    {% endfor %}
                    <th scope="col">Flags</th>
                  </tr>
                </thead>
                <tbody>
                  {% for feature in group.features %}
                  <tr data-cg-feature="{{ feature.name }} {{ feature.feature_id }}">
                    <th scope="row">
                      <span class="cg-constraint" data-bs-toggle="tooltip" title="{{ feature.definition }}">{{ feature.name }}</span>
                    </th>
                    {% for cell in feature.cells %}
                    <td>
                      {% if not cell.researched %}
                      <span class="cg-status cg-status-requires_research" title="Unresearched">&mdash;</span>
                      {% else %}
                      <span class="cg-status cg-status-{{ cell.status }}"
                            {% if cell.rationale %}data-bs-toggle="tooltip" title="{{ cell.rationale }}"{% endif %}>
                        <svg class="cg-status-icon" aria-hidden="true"><use href="#cg-icon-{{ cell.status }}"/></svg>{{ status_labels[cell.status] }}</span>
                      {% if cell.has_constraints %}
                      <div class="mt-1">
                        {% for constraint in cell.constraints %}
                        <span class="cg-constraint" data-bs-toggle="tooltip"
                              title="{{ constraint.get('description') or constraint.get('type') }}">{{ constraint.type }}</span>
                        {% endfor %}
                      </div>
                      {% endif %}
                      {% endif %}
                    </td>
                    {% endfor %}
                    <td>
                      {% for flag in feature.flags %}
                      {% set fkey = flag_meta.get(flag, 'other') %}
                      <span class="cg-flag-icon cg-flag-{{ fkey }}" role="img"
                            data-bs-toggle="tooltip" title="{{ flag }}" aria-label="{{ flag }}">
                        <svg class="cg-flag-icon-glyph" aria-hidden="true"><use href="#cg-icon-flag-{{ fkey }}"/></svg>
                      </span>
                      {% endfor %}
                    </td>
                  </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>

        </div>
        <div class="tab-pane fade p-3 p-md-4" id="page-profiles" role="tabpanel">
        <ul class="nav nav-pills mb-3" role="tablist">
          {% for tool in model.tools %}
          <li class="nav-item" role="presentation">
            <button class="nav-link{% if loop.first %} active{% endif %}" data-bs-toggle="pill"
                    data-bs-target="#profile-{{ tool.tool_id }}" type="button" role="tab">{{ tool.name }}</button>
          </li>
          {% endfor %}
        </ul>
        <div class="tab-content">
          {% for tool in model.tools %}
          {% set profile = profiles_by_id[tool.tool_id] %}
          <div class="tab-pane fade{% if loop.first %} show active{% endif %}"
               id="profile-{{ tool.tool_id }}" role="tabpanel">
            <div class="cg-profile-card">
              <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                <div class="cg-avatar" aria-hidden="true">{{ tool.name[:2]|upper }}</div>
                <h2 class="h4 mb-0">{{ tool.name }}</h2>
                {% if tool.vendor %}<span class="text-muted">by {{ tool.vendor }}</span>{% endif %}
                <span class="cg-fresh cg-fresh-{{ tool.freshness }}">{{ freshness_labels[tool.freshness] }} &middot; researched {{ tool.researched_at }}</span>
                {% if tool.profile_state == 'requires_research' %}
                <span class="cg-flag">requires_research</span>
                {% endif %}
              </div>
              {% if tool.homepage %}
              <p><a href="{{ tool.homepage }}" rel="noopener noreferrer nofollow" target="_blank">{{ tool.homepage }}</a></p>
              {% endif %}
              {% if descriptions.get(tool.tool_id) %}
              <div class="cg-description">{{ descriptions[tool.tool_id] }}</div>
              {% endif %}

              {% if profile.get('use_cases') %}
              <h3 class="h6 mt-3">Use cases</h3>
              <ul class="cg-usecase-list">
                {% for uc in profile.get('use_cases') %}
                <li class="mb-2">
                  <strong>{{ uc.title }}</strong>
                  <span class="cg-flag">{{ 'Documented' if uc.kind == 'documented' else 'Inferred' }}</span>
                  <div>{{ uc.description|md }}</div>
                  {% if uc.kind == 'inferred' %}
                  {% if uc.rationale %}
                  <p class="text-muted small mb-1"><em>Why inferred:</em> {{ uc.rationale }}</p>
                  {% endif %}
                  {% if uc.supporting_features %}
                  <p class="small mb-1">
                    <em>Supporting features:</em>
                    {% for fid in uc.supporting_features %}<span class="cg-constraint">{{ fid }}</span>{% endfor %}
                  </p>
                  {% endif %}
                  {% elif uc.evidence %}
                  <ul class="small mb-1">
                    {% for ev in uc.evidence %}<li>&ldquo;{{ ev.excerpt }}&rdquo;</li>{% endfor %}
                  </ul>
                  {% endif %}
                </li>
                {% endfor %}
              </ul>
              {% endif %}

              {% set feature_sections = tool_feature_sections.get(tool.tool_id, []) %}
              {% if feature_sections %}
              <h3 class="h6 mt-3">Features</h3>
              {% for section in feature_sections %}
              <h4 class="h6 mt-2 mb-1 text-muted">{{ section.name }}</h4>
              <ul class="cg-feature-list">
                {% for row in section.rows %}
                {% set feature = row.feature %}
                {% set cell = row.cell %}
                <li class="mb-2">
                  <span class="cg-status cg-status-{{ cell.status }}">
                    <svg class="cg-status-icon" aria-hidden="true"><use href="#cg-icon-{{ cell.status }}"/></svg>{{ status_labels[cell.status] }}
                  </span>
                  <strong>{{ feature.name }}</strong>
                  {% if cell.rationale %}<div class="text-muted small">{{ cell.rationale }}</div>{% endif %}
                  {% if cell.has_constraints %}
                  <div class="mt-1">
                    {% for constraint in cell.constraints %}
                    <span class="cg-constraint" data-bs-toggle="tooltip"
                          title="{{ constraint.get('description') or constraint.get('type') }}">{{ constraint.type }}</span>
                    {% endfor %}
                  </div>
                  {% endif %}
                </li>
                {% endfor %}
              </ul>
              {% endfor %}
              {% endif %}

              {% set fact_sections = tool_fact_sections.get(tool.tool_id, []) %}
              {% if fact_sections %}
              <h3 class="h6 mt-3">Additional facts</h3>
              {% for heading, facts in fact_sections %}
              <h4 class="h6 mt-2 mb-1 text-muted">{{ heading }}</h4>
              <ul>
                {% for fact in facts %}
                <li class="mb-2">
                  <strong>{{ fact.topic }}:</strong> {{ fact.description|md }}
                  {% if fact.evidence %}
                  <ul class="small mb-1">
                    {% for ev in fact.evidence %}<li>&ldquo;{{ ev.excerpt }}&rdquo;</li>{% endfor %}
                  </ul>
                  {% endif %}
                </li>
                {% endfor %}
              </ul>
              {% endfor %}
              {% endif %}

              {% if profile.get('release_history') %}
              <h3 class="h6 mt-3">Release history</h3>
              <p class="text-muted small">Release history reflects data available as of {{ tool.researched_at }}; check the vendor's official channel for newer releases.</p>
              <ul class="cg-release-list">
                {% for rel in profile.get('release_history')|sort(attribute='release_date', reverse=true) %}
                <li class="mb-2">
                  <strong>{{ rel.version }}</strong> &middot; {{ rel.release_date }}{% if rel.get('product_version') %} &middot; {{ rel.product_version }}{% endif %}
                  <div>{{ rel.summary|md }}</div>
                  {% if rel.evidence %}
                  <ul class="small mb-1">
                    {% for ev in rel.evidence %}<li>&ldquo;{{ ev.excerpt }}&rdquo;</li>{% endfor %}
                  </ul>
                  {% endif %}
                </li>
                {% endfor %}
              </ul>
              {% endif %}
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
      </div>
      </div>

    <footer class="cg-footer d-flex flex-wrap justify-content-between align-items-start gap-3">
      <div>
        <div class="cg-flag-legend mb-2" aria-label="Flag legend">
          {% for label, key in flag_meta.items() %}
          <span class="cg-flag-legend-item">
            <span class="cg-flag-icon cg-flag-{{ key }}" role="img" aria-hidden="true">
              <svg class="cg-flag-icon-glyph"><use href="#cg-icon-flag-{{ key }}"/></svg>
            </span>{{ label }}
          </span>
          {% endfor %}
        </div>
        <p class="mb-1">Flags describe only the compared set, not the wider market. Hover a flag icon for its meaning. Unresearched or uncertain cells are excluded from flags.</p>
        <p class="mb-0">Self-contained offline report. Bundled Bootstrap (MIT) and Montserrat (SIL OFL). Capgemini-inspired theme.</p>
      </div>
      <div class="cg-cta-card">
        <p class="mb-1 fw-semibold">Want to explore a tool in detail?</p>
        <p class="mb-0 text-muted small">
          Visit
          <a href="#page-profiles" data-bs-toggle="tab" data-bs-target="#page-profiles">Profiles</a>
          to see in-depth information on each AI coding tool.
          <svg class="cg-cta-arrow" aria-hidden="true"><use href="#cg-icon-chevron-right"/></svg>
        </p>
      </div>
    </footer>
  </main>

  <script>{{ assets.bootstrap_js|safe }}</script>
  <script>{{ assets.app_js|safe }}</script>
</body>
</html>
